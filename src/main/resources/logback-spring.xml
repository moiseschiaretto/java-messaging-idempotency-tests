<?xml version="1.0" encoding="UTF-8"?>
<!--
    logback-spring.xml

    Define dois destinos de log:
      1) CONSOLE — saida padrao no terminal durante a execucao (o mesmo
         padrao usado nos demais projetos do portfolio: acompanhar em tempo
         real o que esta acontecendo, tanto local quanto no CI).
      2) FILE_EVIDENCE — log estruturado em arquivo, salvo em
         logs/{data}/messaging-evidence.log, contendo o rastro completo de
         mensagens publicadas e consumidas. E a adaptacao do padrao usado no
         projeto playwright-public-api-contract-tests (que salvava cada
         resposta HTTP em logs/{recurso}/{metodo}/{status}/*.json).
-->
<configuration>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Console: log legivel durante a execucao (local ou GitHub Actions) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Arquivo: log estruturado de evidencias, um arquivo novo por dia -->
    <appender name="FILE_EVIDENCE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/messaging-evidence.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/messaging-evidence.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Logger dedicado as evidencias de mensageria (usado pelo MessageTestHelper) -->
    <logger name="com.moises.messaging.evidence" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_EVIDENCE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
